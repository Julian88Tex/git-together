salesforce.Flow Contact_Duplicate_Creation {
  fullName = "Contact_Duplicate_Creation"
  apiVersion = 58
  areMetricsLoggedToDataCloud = false
  description = "Creates a duplicate contact with \"2\" added to the last name whenever a new contact is created"
  environments = "Default"
  formulas = [
    {
      name = "DuplicateLastName"
      dataType = "String"
      expression = "{!$Record.LastName} & '2'"
    },
  ]
  interviewLabel = "Contact Duplicate Creation {!$Flow.CurrentDateTime}"
  label = "Contact Duplicate Creation"
  processMetadataValues = [
    {
      name = "BuilderType"
      value = {
        stringValue = "LightningFlowBuilder"
      }
    },
  ]
  processType = "AutoLaunchedFlow"
  recordCreates = [
    {
      name = "Create_Duplicate_Contact"
      label = "Create Duplicate Contact"
      locationX = 176
      locationY = 335
      inputAssignments = [
        {
          field = salesforce.Contact.field.Email
          value = {
            elementReference = salesforce.Contact.field.Email
          }
        },
        {
          field = "FirstName"
          value = {
            elementReference = "$Record.FirstName"
          }
        },
        {
          field = "LastName"
          value = {
            elementReference = "DuplicateLastName"
          }
        },
        {
          field = salesforce.Contact.field.Phone
          value = {
            elementReference = salesforce.Contact.field.Phone
          }
        },
      ]
      object = salesforce.Contact
      storeOutputAutomatically = true
    },
  ]
  start = {
    locationX = 50
    locationY = 0
    connector = {
      targetReference = "Create_Duplicate_Contact"
    }
    object = salesforce.Contact
    recordTriggerType = "Create"
    triggerType = "RecordAfterSave"
  }
  status = "Obsolete"
  _parent = [
    salesforce.Contact,
  ]
  _alias = "Contact Duplicate Creation"
}
