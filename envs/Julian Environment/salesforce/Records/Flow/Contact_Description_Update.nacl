salesforce.Flow Contact_Description_Update {
  fullName = "Contact_Description_Update"
  apiVersion = 58
  description = "Automatically fills in the Contact's Description field with \"Hello World\" when a new Contact is created"
  environments = "Default"
  interviewLabel = "Contact Description Update {!$Flow.CurrentDateTime}"
  label = "Contact Description Update"
  processMetadataValues = [
    {
      name = "BuilderType"
      value = {
        stringValue = "LightningFlowBuilder"
      }
    },
  ]
  processType = "AutoLaunchedFlow"
  recordUpdates = [
    {
      name = "Update_Contact_Description"
      label = "Update Contact Description"
      locationX = 176
      locationY = 335
      inputAssignments = [
        {
          field = "Description"
          value = {
            stringValue = "Hello World"
          }
        },
      ]
      inputReference = "$Record"
    },
  ]
  start = {
    locationX = 50
    locationY = 0
    connector = {
      targetReference = "Update_Contact_Description"
    }
    object = salesforce.Contact
    recordTriggerType = "Create"
    triggerType = "RecordAfterSave"
  }
  status = "Obsolete"
  _parent = [
    salesforce.Contact,
  ]
  _alias = "Contact Description Update"
}
