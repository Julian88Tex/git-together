salesforce.Flow Contact_Name_Switch_Creation {
  fullName = "Contact_Name_Switch_Creation"
  apiVersion = 58
  areMetricsLoggedToDataCloud = false
  description = "Creates a duplicate contact with first and last names switched whenever a new contact is created"
  environments = "Default"
  interviewLabel = "Contact Name Switch Creation {!$Flow.CurrentDateTime}"
  label = "Contact Name Switch Creation"
  processMetadataValues = [
    {
      name = "BuilderType"
      value = {
        stringValue = "LightningFlowBuilder"
      }
    },
  ]
  processType = "AutoLaunchedFlow"
  recordCreates = [
    {
      name = "Create_Switched_Name_Contact"
      label = "Create Switched Name Contact"
      locationX = 176
      locationY = 335
      inputAssignments = [
        {
          field = salesforce.Contact.field.Email
          value = {
            elementReference = salesforce.Contact.field.Email
          }
        },
        {
          field = "FirstName"
          value = {
            elementReference = "$Record.LastName"
          }
        },
        {
          field = "LastName"
          value = {
            elementReference = "$Record.FirstName"
          }
        },
        {
          field = salesforce.Contact.field.Phone
          value = {
            elementReference = salesforce.Contact.field.Phone
          }
        },
      ]
      object = salesforce.Contact
      storeOutputAutomatically = true
    },
  ]
  start = {
    locationX = 50
    locationY = 0
    connector = {
      targetReference = "Create_Switched_Name_Contact"
    }
    object = salesforce.Contact
    recordTriggerType = "Create"
    triggerType = "RecordAfterSave"
  }
  status = "Obsolete"
  _parent = [
    salesforce.Contact,
  ]
  _alias = "Contact Name Switch Creation"
}
